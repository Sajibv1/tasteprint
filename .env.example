# Qloo hackathon API — https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional: any OpenAI-compatible chat API for richer explanation copy and
# LLM-driven refinement-note interpretation. Without it, Tasteprint falls back
# to built-in templates and a regex note parser.
# Example (Groq): LLM_BASE_URL=https://api.groq.com/openai/v1 · LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
